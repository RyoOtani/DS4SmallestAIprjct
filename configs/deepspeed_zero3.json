{
    "_comment": "DeepSpeed ZeRO Stage 3 config for Hierarchical MoE 3.0B/14.5B",
    "_comment_memory": "Without ZeRO: ~120GB → ZeRO-3: ~30GB + activations per GPU",

    "train_batch_size": 256,
    "train_micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": "auto",

    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 2e-4,
            "betas": [0.9, 0.95],
            "eps": 1e-8,
            "weight_decay": 0.1
        }
    },

    "scheduler": {
        "type": "WarmupDecayLR",
        "params": {
            "warmup_min_lr": 0,
            "warmup_max_lr": 2e-4,
            "warmup_num_steps": 1000,
            "total_num_steps": 200000
        }
    },

    "zero_optimization": {
        "stage": 3,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },
        "offload_param": {
            "device": "cpu",
            "pin_memory": true
        },
        "overlap_comm": true,
        "contiguous_gradients": true,
        "reduce_bucket_size": 5e7,
        "stage3_prefetch_bucket_size": 5e7,
        "stage3_param_persistence_threshold": 1e6,
        "stage3_max_live_parameters": 1e9,
        "stage3_max_reuse_distance": 1e9,
        "stage3_gather_16bit_weights_on_model_save": true,
        "sub_group_size": 1e9
    },

    "fp16": {
        "enabled": true,
        "auto_cast": true,
        "loss_scale": 0,
        "initial_scale_power": 16,
        "loss_scale_window": 1000,
        "hysteresis": 2,
        "min_loss_scale": 1
    },

    "_bf16_note": "Use bf16 on A100/H100 for better numerical stability. Replace fp16 block above with:",
    "_bf16_config": {
        "bf16": {
            "enabled": true
        }
    },

    "gradient_clipping": 1.0,

    "activation_checkpointing": {
        "partition_activations": true,
        "cpu_checkpointing": false,
        "number_checkpoints": null,
        "synchronize_checkpoint_boundary": false,
        "profile": false
    },

    "wall_clock_breakdown": true,

    "_spot_instance_notes": {
        "checkpoint_frequency": "every 30 min or 500 steps",
        "preemption_signal": "SIGTERM (handled by training/checkpoint.py)",
        "auto_upload": "use CheckpointManager with s3_upload_hook or gcs_upload_hook",
        "estimated_restart_overhead": "2-5 min (load checkpoint + recompile)"
    },

    "flops_profiler": {
        "enabled": false,
        "profile_step": 1,
        "module_depth": -1,
        "top_modules": 3,
        "detailed": true,
        "output_file": null
    }
}
